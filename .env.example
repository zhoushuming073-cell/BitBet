# BitBet 环境变量示例 —— 复制为 .env.local 并按需填写，切勿提交真实密钥。

# CloudBase 环境 ID（公开标识，浏览器 SDK 需要，例如 zsmcloud-d7g8r7pemc270c160）
# 正式账号使用 CloudBase Web Auth；游客始终只保存在本机。
NEXT_PUBLIC_CLOUDBASE_ENV_ID=
NEXT_PUBLIC_ENABLE_LEGACY_NOSQL_DEV=false

# CloudBase MySQL 直连。优先使用完整连接串；也可改用下方五个字段。
# 生产必须使用云托管内网地址，本地调试才使用外网地址。
CONNECTION_URI=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=tcb
DB_POOL_SIZE=10

# 只有当请求必经“已开启身份认证”的 CloudBase HTTP 网关时才设为 true。
CLOUDBASE_HTTP_AUTH_VERIFIED=false

# 仅本地联调。生产代码即使收到客户端 midPrice 也会拒绝。
ALLOW_CLIENT_MARKET_PRICE_DEV=false

# 生产内部结算任务调用 /api/game/settle 时使用，禁止暴露到浏览器。
INTERNAL_SETTLEMENT_SECRET=
